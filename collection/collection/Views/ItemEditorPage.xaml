<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="collection.Views.ItemEditorPage"
             Title="Edycja elementu"
             BackgroundColor="#4B5457">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="10">
            <Label Text="Nazwa elementu" TextColor="Black" />
            <Entry x:Name="NameEntry" TextColor="Black" PlaceholderColor="Gray" />

            <Label Text="Cena" TextColor="Black" />
            <Entry x:Name="PriceEntry" Placeholder="00.00" Keyboard="Numeric" TextColor="Black" PlaceholderColor="Gray" />

            <Label Text="Status" TextColor="Black" />
            <Picker x:Name="StatusPicker" TextColor="Black" TitleColor="Gray" />

            <Label Text="Ocena (1-10)" TextColor="Black" />
            <Slider x:Name="RatingStepper" Minimum="1" Maximum="10" Value="1" ValueChanged="OnRatingChanged" />
            <Label x:Name="RatingLabel" Text="1/10" TextColor="Black" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,10,0,0">
                <Button Text="Zapisz" BackgroundColor="#4FB9D6" Clicked="OnSaveClicked"/>
                <Button Grid.Column="1" Text="Anuluj" BackgroundColor="#D6914F" Clicked="OnCancelClicked" />
            </Grid>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
